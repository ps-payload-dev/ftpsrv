PLATFORM := ps4
PYTHON3 ?= python3
PS4_HOST ?= ps4
PS4_PORT ?= 9021

ifndef PS4_PAYLOAD_SDK
$(error PS4_PAYLOAD_SDK is undefined)
endif
include $(PS4_PAYLOAD_SDK)/toolchain/orbis.mk

PAYLOAD := build/ps4/ftpsrv-ps4.elf
INSTALLER := build/ps4/ftpsrv-ps4-install.elf
TARGETS := $(PAYLOAD) $(INSTALLER)
VERSION_TAG := $(shell git describe --abbrev=6 --dirty --always --tags)
TITLE_ID := BREW10001
CFLAGS := -Wall -Werror -Iheaders -DVERSION_TAG=\"$(VERSION_TAG)\"
SOURCE := cmd.c io.c io-freebsd.c notify.c self.c sha256.c srv.c
SOURCE += cmd-orbis.c main-orbis.c self-orbis.c
ASSETS := assets/param.json assets/icon0.png assets/websrv.html
ASSETS += assets/xterm.min.js assets/xterm.min.css

# linker script and signing tools from the install_app sample of the PS4 payload
# SDK, the eboot itself is source/ps4/eboot-ps4.c
INSTALL_APP_DIR := $(PS4_PAYLOAD_SDK)/samples/install_app
PS4_SDK_VERSION ?= 0x03500000
AUTHID := 0x3800000000000011
AUTHINFO := 00 00 00 00 00 00 00 00 00 00 00 00 00 1C 00 40 00 FF 00 00 00 00 \
            00 80 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 80 \
            00 40 00 40 00 00 00 00 00 00 00 80 00 00 00 00 00 00 00 08 00 40 \
            FF FF 00 00 00 F0 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 \
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 \
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 \
            00 00 00 00

include Makefile.build

BOOT_ELF := $(PAYLOAD)

# BIN bootstrapper: a flat x86-64 image that maps $(BOOT_ELF) into memory,
# applies its relative relocations and jumps to its entry point
BOOT_BIN := $(BOOT_ELF:.elf=.bin)
BOOT_DIR := $(BUILD_DIR)/bootstrap

all: $(BOOT_BIN)

$(BOOT_DIR)/bin.o: source/ps4/bootstrap-bin.c $(BOOT_ELF)
	@mkdir -p $(dir $@)
	$(CC) -O2 -fPIC -fno-stack-protector -fno-builtin -Wall -Werror 	    -DBOOT_ELF=\"$(BOOT_ELF)\" -c -o $@ $<

$(BOOT_DIR)/bin.elf: $(BOOT_DIR)/bin.o source/ps4/bin_x86_64.x
	$(LD) -T source/ps4/bin_x86_64.x -o $@ $<

$(BOOT_BIN): $(BOOT_DIR)/bin.elf
	$(OBJCOPY) -O binary --only-section=.text $< $@

OPENER := $(OBJ_DIR)/open.elf

INSTALL_ASSETS := -DTITLE_ID=\"$(TITLE_ID)\" -DEBOOT=\"$(OBJ_DIR)/eboot.bin\"
INSTALL_ASSETS += -DPARAM=\"$(OBJ_DIR)/param.sfo\" -DICON0=\"assets/icon0.png\"
INSTALL_ASSETS += -DPAYLOAD=\"$(PAYLOAD)\" -DOPENER=\"$(OPENER)\"
INSTALL_ASSETS += -DWEBSRV=\"assets/websrv.html\"
INSTALL_ASSETS += -DXTERM_JS=\"assets/xterm.min.js\"
INSTALL_ASSETS += -DXTERM_CSS=\"assets/xterm.min.css\"

.INTERMEDIATE: $(OBJ_DIR)/eboot.elf

# opens the web page that deploys ftpsrv, sent to the ELF loader by the eboot
$(OPENER): source/ps4/open-ps4.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -DTITLE_ID=\"$(TITLE_ID)\" -o $@ $< -lkernel -lSceSystemService -lSceUserService

$(OBJ_DIR)/eboot.o: source/ps4/eboot-ps4.c
	@mkdir -p $(dir $@)
	$(CC) -DTITLE_ID=\"$(TITLE_ID)\" -c -o $@ $<

$(OBJ_DIR)/eboot.elf: $(OBJ_DIR)/eboot.o
	$(LD) --static -T $(INSTALL_APP_DIR)/eboot.x -o $@ $<

$(OBJ_DIR)/eboot.bin: $(OBJ_DIR)/eboot.elf
	$(INSTALL_APP_DIR)/make_fself.py --ptype fake --paid $(AUTHID) \
	    --auth-info "$(AUTHINFO)" \
	    --app-version $(PS4_SDK_VERSION) \
	    --fw-version $(PS4_SDK_VERSION) $< $@

$(OBJ_DIR)/param.sfo: assets/param.json
	@mkdir -p $(dir $@)
	$(INSTALL_APP_DIR)/json2sfo.py $< $@
	$(PYTHON3) -c "import sys; d=open(sys.argv[1],'rb').read(); assert d.count(b'gd\x00\x00')==1; open(sys.argv[1],'wb').write(d.replace(b'gd\x00\x00',b'gde\x00'))" $@

$(OBJ_DIR)/install-ps4.o: source/ps4/install-ps4.c $(PAYLOAD) $(OPENER) $(ASSETS) $(OBJ_DIR)/eboot.bin $(OBJ_DIR)/param.sfo
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INSTALL_ASSETS) -c $< -o $@

$(INSTALLER): $(OBJ_DIR)/install-ps4.o
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) -o $@ $^ -lSceIpmi -lSceAppInstUtil -lSceUserService -lSceSystemService

install: $(INSTALLER)
	$(PS4_DEPLOY) -h $(PS4_HOST) -p $(PS4_PORT) $<

test: $(PAYLOAD)
	$(PS4_DEPLOY) -h $(PS4_HOST) -p $(PS4_PORT) $<
